<launch>

    <let name="urdf_path" 
         value="$(find-pkg-share deliverbot_description)/urdf/main.urdf.xacro"/>

    
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
         <param  name="robot_description" value="$(command 'xacro $(var urdf_path) ')" />
    </node>


   <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" name="joint_state_publisher_gui" output="screen">
    	<param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
   </node>


    <node pkg="rviz2" exec= "rviz2" output="screen"
     args="-d $(find-pkg-share deliverbot_description)/rviz/rviz_config.rviz" />
    

</launch>
