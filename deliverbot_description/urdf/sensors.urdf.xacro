<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                 <box size="0.01 0.2 0.04" />
            </geometry>
            <material name="stain_black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.01 0.2 0.04" />
            </geometry>
        </collision>
        <xacro:box_inertia m="0.1" l="0.01" w="0.04" h="0.2" xyz="0 0 0" rpy="0 0 0"/>
    </link>

    <link name="imu_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.1 0.05 0.03" />
            </geometry>
            <material name="stain_black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.1 0.05 0.03" />
            </geometry>
        </collision>
        <xacro:box_inertia m="0.1" l="0.1" w="0.03" h="0.05" xyz="0 0 0" rpy="0 0 0"/>
    </link>

    <!-- <link name="ultrasonic_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                 <box size="0.01 0.1 0.04" />
            </geometry>
            <material name="stain_black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.01 0.1 0.04" />
            </geometry>
        </collision>
        <xacro:box_inertia m="0.1" l="0.01" w="0.04" h="0.1" xyz="0 0 0" rpy="0 0 0"/>
    </link> -->


    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="0.36 0 0.319845" rpy="0 0 0" />
    </joint>

    <joint name="base_imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0 0 0.01" rpy="0 0 0" />
    </joint>

    <!-- <joint name="base_ultrasonic_joint" type="fixed">
        <parent link="base_link" />
        <child link="ultrasonic_link" />
        <origin xyz="0 0.31 0.2" rpy="0 0 1.57" />
    </joint> -->


    
</robot>