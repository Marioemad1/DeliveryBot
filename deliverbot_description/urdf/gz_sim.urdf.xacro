<?xml version="1.0"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema" >


    <gazebo reference="middle_left_wheel">
        <mu1 value="1.0"/>
        <mu2 value="1.0"/>
    </gazebo>

    <gazebo reference="middle_right_wheel">
        <mu1 value="1.0"/>
        <mu2 value="1.0"/>
    </gazebo>

    <gazebo reference="front_left_wheel">
        <mu1 value="0.05"/>
        <mu2 value="0.05"/>
    </gazebo>

    <gazebo reference="front_right_wheel">
        <mu1 value="0.05"/>
        <mu2 value="0.05"/>
    </gazebo>

    <gazebo reference="rear_left_wheel">
        <mu1 value="0.05"/>
        <mu2 value="0.05"/>
    </gazebo>

    <gazebo reference="rear_right_wheel">
        <mu1 value="0.05"/>
        <mu2 value="0.05"/>
    </gazebo>

    <gazebo>
        <plugin 
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors" >
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    </gazebo>

    
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find deliverbot_bringup)/config/diff_drive_config.yaml</parameters>
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <ros>
                <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
                <remapping>/diff_drive_controller/cmd_vel:=/cmd_vel</remapping>
                <remapping>/diff_drive_controller/odom:=/odom</remapping>
                <remapping>/Nema_controller/commands:=/opendoor</remapping>
            </ros>
        </plugin>
    </gazebo>

    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <gz_frame_id>lidar_link</gz_frame_id>
            <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <update_rate>25</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>180</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.57</min_angle>   <!-- full 360° -->
                        <max_angle>1.57</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>180</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.57</min_angle>   <!-- full 360° -->
                        <max_angle>1.57</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.8</min>                     <!-- min distance -->
                    <max>20.0</max>                     <!-- max distance -->
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <always_on>1</always_on>
            <visualize>true</visualize>       
        <!-- Sensor gpu_lidar -->
        </sensor>
    </gazebo>

