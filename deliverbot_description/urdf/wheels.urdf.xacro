                <sphere radius="0.139095" />
            </geometry>
        </collision>
        <xacro:sphere_inertial m="2.1688" r="0.139095" xyz="0 0.065 0" rpy="0 0 0" />
    </link>

    <link name="front_left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://deliverbot_description/meshes/wheel.STL" />
            </geometry>
            <material name="stain_black"/>
        </visual>
        <collision>
            <origin xyz="0 -0.065 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.139095" />
            </geometry>
        </collision>
        <xacro:sphere_inertial m="2.1688" r="0.139095" xyz="0 -0.065 0" rpy="0 0 0" />
    </link>

    <link name="middle_left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://deliverbot_description/meshes/wheel.STL" />
            </geometry>
            <material name="stain_black"/>
        </visual>
        <collision>
            <origin xyz="0 -0.065 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.139095" />
            </geometry>
        </collision>
        <xacro:sphere_inertial m="2.1688" r="0.139095" xyz="0 -0.065 0" rpy="0 0 0" />
    </link>

    <link name="rear_left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://deliverbot_description/meshes/wheel.STL" />
            </geometry>
