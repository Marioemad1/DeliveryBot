<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="front_right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${pi}" />
            <geometry>
                <mesh filename="package://deliverbot_description/meshes/wheel.STL" />
            </geometry>
            <material name="stain_black"/>
        </visual>
        <collision>
            <origin xyz="0 0.065 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.139095" />
            </geometry>
        </collision>
        <xacro:sphere_inertial m="2.1688" r="0.139095" xyz="0 0.065 0" rpy="0 0 0" />
    </link>

    <link name="middle_right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${pi}" />
            <geometry>
                <mesh filename="package://deliverbot_description/meshes/wheel.STL" />
            </geometry>
            <material name="stain_black"/>
        </visual>
        <collision>
            <origin xyz="0 0.065 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.139095" />
            </geometry>
        </collision>
        <xacro:sphere_inertial m="2.1688" r="0.139095" xyz="0 0.065 0" rpy="0 0 0" />
    </link>

    <link name="rear_right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${pi}" />
            <geometry>
                <mesh filename="package://deliverbot_description/meshes/wheel.STL" />
            </geometry>
